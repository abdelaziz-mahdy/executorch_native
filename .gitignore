# Build directories
build/
# All build-script output trees: build-<platform>-<arch>-<backends>-<type>/
# (build-macos-*, build-ios-*, build-linux-*, build-android-*, build-windows-*,
# build-local-*) — generated by scripts/build-*.sh, never committed.
build-*/
cmake-build-*/
out/
dist/
local-builds/

# Compile-once/link-many: shared ExecuTorch sub-build dirs keyed by
# (platform, arch, build_type, deployment-target). See cmake/build_from_source.cmake.
.et-shared/

# Compiler cache directories (ccache) used by CI and local builds.
.ccache/
.ccache-*/

# IDE files
.idea/
.vscode/
*.xcworkspace/
*.xcodeproj/
.vs/

# OS files
.DS_Store
Thumbs.db

# CMake generated
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
install_manifest.txt

# Compiled objects
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe

# Python
__pycache__/
*.pyc
*.pyo
.env
venv/

# Cache
.cache/
